model AgentTransfer {
  id                    String         @id @default(cuid())
  organizationId        String
  contactId             String
  contactPhone          String
  whatsappAccount       String
  status                TransferStatus @default(active)
  source                String         @default("manual")
  agentId               String?
  teamId                String?
  transferredByUserId   String?
  resumedById           String?
  notes                 String         @default("")
  transferredAt         DateTime       @default(now())
  resumedAt             DateTime?
  slaResponseDeadline   DateTime?
  slaResolutionDeadline DateTime?
  slaBreached           Boolean        @default(false)
  escalationLevel       Int            @default(0)
  escalatedAt           DateTime?
  pickedUpAt            DateTime?
  queueTimeMins         Int       @default(0)
  resolutionTimeMins    Int       @default(0)
  expiresAt             DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact         Contact      @relation(fields: [contactId], references: [id])
  agent           User?        @relation("TransferAgent", fields: [agentId], references: [id])
  team            Team?        @relation(fields: [teamId], references: [id])
  transferredBy   User?        @relation("TransferInitiator", fields: [transferredByUserId], references: [id])
  resumedBy       User?        @relation("TransferResumer", fields: [resumedById], references: [id])

  @@index([organizationId])
  @@index([contactId])
  @@index([status])
  @@index([agentId])
  @@index([teamId])
}

model ChatbotSettings {
