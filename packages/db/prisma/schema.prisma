// ==================== FEATURE MANAGEMENT ====================
model Feature {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  category    String
  isEnabled   Boolean  @default(true)
  configSchema Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantFeatures TenantFeature[]
  featureUsages  FeatureUsage[]

  @@index([category])
  @@index([isEnabled])
}

// تفعيل الأداة لمستأجر معين (مع إمكانية إعدادات خاصة)
model TenantFeature {
  id         String   @id @default(cuid())
  tenantId   String
  featureId  String
  isActive   Boolean  @default(true)
  settings   Json?    @default("{}")
  usageCount Int      @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant  Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feature Feature      @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([tenantId, featureId])
  @@index([tenantId, isActive])
}

// سجل استخدام الأداة (للتحليل والتدقيق)
model FeatureUsage {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  featureId  String
  action     String
  metadata   Json?
  createdAt  DateTime @default(now())

  tenant Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature Feature     @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@index([tenantId, featureId, userId, createdAt])
  @@index([createdAt])
  @@index([action])
}

// ==================== TWITTER SCRAPER ====================
model TwitterAccount {
  id              String   @id @default(cuid())
  tenantId        String
  username        String   @unique
  email           String
  password        String   // Encrypted
  phoneNumber     String?

  // Account status
  status          String   @default("active") // active, rate_limited, blocked, requires_verification
  isActive        Boolean  @default(true)

  // Rate limiting
  requestsToday   Int      @default(0)
  lastRequestAt   DateTime?

  // Session management
  cookies         Json?    // Encrypted cookies
  authToken       String?  // Bearer token (encrypted)
  csrfToken       String?

  // Metadata
  proxyId         String?  // Optional dedicated proxy
  userAgent       String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions TwitterSession[]
  jobs     ScrapingJob[]

  @@index([tenantId, status])
  @@index([username])
}

model TwitterSession {
  id          String   @id @default(cuid())
  accountId   String
  sessionToken String  @unique
  cookies     Json
  expiresAt   DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  account TwitterAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, isActive])
  @@index([expiresAt])
}

// ==================== SCRAPER SYSTEM ====================
model ScrapingJob {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  platform    String   // instagram, twitter, linkedin, tiktok
  type        String   // profile, posts, followers, hashtag, search
  target      String   // username, URL, or hashtag
  options     Json     @default("{}")
  status      String   // pending, running, completed, failed, cancelled
  progress    Int      @default(0)
  error       String?

  // Twitter specific
  twitterAccountId String?
  twitterAccount   TwitterAccount? @relation(fields: [twitterAccountId], references: [id])

  // Job configuration
  config Json? // twitter-specific config (include_replies, include_retweets, etc)

  results     ScrapedData[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([createdAt])
  @@index([platform])
}

model ScrapedData {
  id         String   @id @default(cuid())
  jobId      String
  platform   String
  type       String
  data       Json     // The actual scraped data
  sourceUrl  String
  scrapedAt  DateTime @default(now())
  createdAt  DateTime @default(now())

  job ScrapingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([platform, scrapedAt])
}

model ScraperRequestLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  jobId     String
  platform  String
  target    String
  timestamp DateTime @default(now())

  tenant Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, timestamp])
  @@index([jobId])
}

model GroupJoinRequest {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  groupId     String
  groupName   String
  inviteLink  String
  autoJoin    Boolean  @default(false)
  status      String   @default("pending")
  error       String?
  requestedAt DateTime @default(now())
  approvedAt  DateTime?
  joinedAt    DateTime?

  tenant Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, status])
  @@index([groupId])
}

model UserGroupMembership {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  groupId    String
  groupName  String
  inviteLink String
  joinedAt   DateTime @default(now())
  leftAt     DateTime?
  isActive   Boolean  @default(true)
  lastActive DateTime?

  tenant Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, groupId])
  @@index([tenantId, userId, isActive])
}

model JoinConsent {
  id            String   @id @default(cuid())
  tenantId      String
  userId        String
  consentGiven  Boolean  @default(true)
  consentAt     DateTime @default(now())
  ipAddress     String?
  revokedAt     DateTime?
  revokedReason String?

  tenant Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
}
