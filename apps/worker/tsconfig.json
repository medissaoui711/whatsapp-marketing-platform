{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "module": "CommonJS",
    "target": "ES2020",
    "lib": ["ES2020"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "paths": {
      "@repo/db": ["../../packages/db/src"],
      "@repo/db/*": ["../../packages/db/src/*"],
      "@repo/auth": ["../../packages/auth/src"],
      "@repo/auth/*": ["../../packages/auth/src/*"],
      "@repo/queue": ["../../packages/queue/src"],
      "@repo/queue/*": ["../../packages/queue/src/*"],
      "@repo/integrations": ["../../packages/integrations/src"],
      "@repo/integrations/*": ["../../packages/integrations/src/*"],
      "@repo/scraper": ["../../packages/scraper/src"],
      "@repo/scraper/*": ["../../packages/scraper/src/*"],
      "@repo/webhooks": ["../../packages/webhooks/src"],
      "@repo/webhooks/*": ["../../packages/webhooks/src/*"],
      "@repo/shared": ["../../packages/shared/src"],
      "@repo/shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": [
    "src/**/*",
    "../../packages/db/src/**/*",
    "../../packages/auth/src/**/*",
    "../../packages/queue/src/**/*",
    "../../packages/integrations/src/**/*",
    "../../packages/scraper/src/**/*",
    "../../packages/webhooks/src/**/*"
  ],
  "exclude": ["node_modules", "dist", "../../packages/**/dist"]
}
