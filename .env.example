# App
NODE_ENV="development"
APP_NAME="Whatomate"
APP_DEBUG="true"
ENCRYPTION_KEY="your-32-byte-encryption-key-change-me-in-production"

# Server
PORT="3000"
SERVER_HOST="0.0.0.0"
ALLOWED_ORIGINS="http://localhost:3000"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saas_platform"
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="postgres"
DB_PASSWORD="postgres"
DB_NAME="saas_platform"
DB_SSL_MODE="disable"

# Redis
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_DB="0"

# JWT
JWT_SECRET="your-super-secret-jwt-secret-key-change-me-in-production"
REFRESH_SECRET="your-super-secret-refresh-secret-key-change-me-in-production"
JWT_ACCESS_EXPIRY_MINS="15"
JWT_REFRESH_EXPIRY_DAYS="7"

# WhatsApp
WHATSAPP_API_VERSION="v18.0"
WHATSAPP_BASE_URL="https://graph.facebook.com"
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# AI Keys (optional)
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GOOGLE_AI_KEY=""

# Storage (local or s3)
STORAGE_TYPE="local"
STORAGE_LOCAL_PATH="./uploads"
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_ENDPOINT=""

# Rate Limiting
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_LOGIN_MAX="10"
RATE_LIMIT_REGISTER_MAX="10"
RATE_LIMIT_REFRESH_MAX="30"
RATE_LIMIT_WINDOW_SECONDS="60"
RATE_LIMIT_API_MAX="100"
RATE_LIMIT_API_WINDOW="60"

# Cookie
COOKIE_SECURE="false"
# COOKIE_DOMAIN=""

# TTS Configuration
PIPER_BINARY=piper
PIPER_MODEL=./models/voice.onnx
OPUSENC_BINARY=opusenc
TTS_AUDIO_DIR=./audio/tts

# Calling / WebRTC
# CALLING_PUBLIC_IP=""
# CALLING_UDP_PORT_MIN="10000"
# CALLING_UDP_PORT_MAX="10100"
# CALLING_RECORDING_ENABLED="false"

# Default Admin
DEFAULT_ADMIN_EMAIL="admin@demo.com"
DEFAULT_ADMIN_PASSWORD="admin123"
