{
  "name": "saas-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:all",
    "dev:web": "npm run dev --workspace=web -- -p 4000",
    "dev:ws": "set WS_PORT=4001&& npm run dev --workspace=ws-server",
    "dev:all": "concurrently -n web,ws -c blue,green \"npm run dev:web\" \"npm run dev:ws\"",
    "build": "npm run build:packages && npm run build:web && npm run build:worker",
    "build:packages": "npm run build --workspaces --if-present --parallel",
    "build:web": "npm run build --workspace=web",
    "build:worker": "npm run build --workspace=worker",
    "start": "npm run start --workspace=web",
    "db:generate": "npm run generate --workspace=db",
    "db:migrate": "npm run migrate:deploy --workspace=db",
    "db:migrate:dev": "npm run migrate:dev --workspace=db",
    "db:seed": "npm run seed --workspace=db",
    "db:reset": "npm run reset --workspace=db",
    "db:studio": "npm run studio --workspace=db",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config=tests/e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --ui --config=tests/e2e/playwright.config.ts",
    "test:e2e:debug": "playwright test --debug --config=tests/e2e/playwright.config.ts",
    "deploy:production": "bash scripts/deploy.sh",
    "deploy:rollback": "bash scripts/rollback.sh",
    "lint": "eslint . --ext .ts,.tsx",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/crypto-js": "^4.2.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.1",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "@vitest/coverage-v8": "^4.1.8",
    "concurrently": "^8.2.2",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "testcontainers": "^12.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1057.0",
    "@aws-sdk/s3-request-presigner": "^3.1057.0",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.4.0",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0"
  },
  "resolutions": {
    "ioredis": "^5.3.2"
  },
  "overrides": {
    "bullmq": {
      "ioredis": "^5.3.2"
    }
  }
}
